{
  "extends": "@repo/config/tsconfig/base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@repo/ai-adapter/*": ["src/*"]
    },
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "noEmit": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
